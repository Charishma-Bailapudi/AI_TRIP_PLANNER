# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/ai-trip-planner

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_access_token_key_change_me
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_me
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Third-Party External APIs
GEMINI_API_KEY=your_gemini_api_key_here
AMADEUS_CLIENT_ID=your_amadeus_flight_client_id_here
AMADEUS_CLIENT_SECRET=your_amadeus_flight_client_secret_here
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
ROME2RIO_API_KEY=your_rome2rio_train_api_key_here
